(version 1)

# JLCPCB 2-layer 1 oz limits that Board Setup > Constraints cannot express.
# Board Setup holds JLCPCB's absolute minimums; net classes hold the design values.

(rule "JLC PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

(rule "JLC PTH hole to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC pad hole to hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC NPTH minimum drill"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

# The stock TestPoint_Pad_D1.0mm ring sits 0.14 mm from its own pad; the fab
# clips silk off pads, so only a test point's own ring is exempt.
(rule "JLC pad to silkscreen"
	(condition "B.Type == 'Pad' && !(A.memberOfFootprint('TP*') && B.memberOfFootprint('TP*'))")
	(constraint silk_clearance (min 0.15mm)))

# Keep copper out from under M3 screw heads, washers and standoffs (r = 3.75 mm), so
# metal mounting hardware cannot join board GND to a grounded frame around F2.
(rule "M3 hardware keepout"
	(condition "A.memberOfFootprint('H*')")
	(constraint hole_clearance (min 2.15mm)))

# Spec section 8: 0.5 mm minimum on the 24 V, LED and ground-return nets.
(rule "Power track width"
	(condition "A.NetClass == 'Power'")
	(constraint track_width (min 0.5mm)))
